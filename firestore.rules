rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can only read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }
    
    // Households: users can read/write if they're a member
    match /households/{householdId} {
      allow read, write: if request.auth.uid in resource.data.members;
    }
    
    // Sub-collections under households (priorityStack, transactions, etc)
    match /households/{householdId}/{document=**} {
      allow read, write: if request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
    }
  }
}
