rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
   
   // ========================================================================
   // USERS COLLECTION
   // ========================================================================
   // Users can only read/write their own user document
   match /users/{userId} {
     allow read: if request.auth.uid == userId;
     allow write: if request.auth.uid == userId;
     allow create: if request.auth.uid == userId;
     allow delete: if request.auth.uid == userId;
   }
   
   // ========================================================================
   // HOUSEHOLDS COLLECTION
   // ========================================================================
   // Users can only access households they are a member of
   match /households/{householdId} {
     allow read: if request.auth.uid in resource.data.members;
     allow write: if request.auth.uid in resource.data.members && 
                     // Only owner can write to household document
                     resource.data.createdBy == request.auth.uid;
     allow create: if request.auth.uid != null;
   }
   
   // ========================================================================
   // PRIORITY STACKS (ACTIVE & DRAFT)
   // ========================================================================
   // Users can read/write priority stacks only if they're in the household
   match /households/{householdId}/priorityStackActive {
     allow read: if request.auth.uid in get(/databases/{database}/documents/households/{householdId}).data.members;
     allow write: if request.auth.uid in get(/databases/{database}/documents/households/{householdId}).data.members &&
                     // Only owner can write active stack
                     get(/databases/{database}/documents/households/{householdId}).data.createdBy == request.auth.uid;
   }
   
   match /households/{householdId}/priorityStackDraft {
     allow read: if request.auth.uid in get(/databases/{database}/documents/households/{householdId}).data.members;
     allow write: if request.auth.uid in get(/databases/{database}/documents/households/{householdId}).data.members;
   }
   
   // ========================================================================
   // PRIORITY STACK APPROVALS
   // ========================================================================
   // Users can read/write approvals only if they're in the household
   match /households/{householdId}/priorityStackApprovals/{approvalId} {
     allow read: if request.auth.uid in get(/databases/{database}/documents/households/{householdId}).data.members;
     allow write: if request.auth.uid in get(/databases/{database}/documents/households/{householdId}).data.members;
     allow create: if request.auth.uid in get(/databases/{database}/documents/households/{householdId}).data.members;
   }
   
   // ========================================================================
   // TRANSACTIONS COLLECTION
   // ========================================================================
   // Users can read/write transactions only if they're in the household
   match /households/{householdId}/transactions/{transactionId} {
     allow read: if request.auth.uid in get(/databases/{database}/documents/households/{householdId}).data.members;
     allow write: if request.auth.uid in get(/databases/{database}/documents/households/{householdId}).data.members;
     allow create: if request.auth.uid in get(/databases/{database}/documents/households/{householdId}).data.members;
   }
   
   // ========================================================================
   // UNLOCK INTENTS COLLECTION
   // ========================================================================
   // Users can read/write unlock intents only if they're in the household
   match /households/{householdId}/unlockIntents/{intentId} {
     allow read: if request.auth.uid in get(/databases/{database}/documents/households/{householdId}).data.members;
     allow write: if request.auth.uid in get(/databases/{database}/documents/households/{householdId}).data.members;
     allow create: if request.auth.uid in get(/databases/{database}/documents/households/{householdId}).data.members;
   }
   
   // ========================================================================
   // CATCH-ALL: DENY BY DEFAULT
   // ========================================================================
   match /{document=**} {
     allow read, write: if false;
   }
 }
}
