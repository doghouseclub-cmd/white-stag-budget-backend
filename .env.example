# Firebase Admin SDK
# From: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Supabase
# From: Supabase Dashboard → Settings → API Keys
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Server
PORT=3001
NODE_ENV=development
